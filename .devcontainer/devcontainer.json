{
    "name": "GDXViewer DevContainer",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "."
    },
    "runArgs": ["--name", "GDXViewer-container"],
    "postCreateCommand": "python3 -m venv .venv && echo '*' > .venv/.gitignore && .venv/bin/pip install 'gamsapi[transfer]>=50.1.0' 'gamspy_base>=50.1.0'",
    "customizations": {
        "vscode": {
            "settings": {
                "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
            },
            "extensions": [
                "VaibhavnathJha.gdxviewer",
                "/home/vscode/extensions/gams-ide.vsix"
            ]
        }
    },
    "remoteUser": "vscode"
}